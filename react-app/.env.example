# Snowflake connection used by lib/snowflake.ts and the agent route.
# Copy to .env.local and fill in the blanks.
#
# .env.local holds live credentials and must NEVER be committed. It is covered by
# .gitignore; keep it that way.

SNOWFLAKE_ACCOUNT=<YOUR_SNOWFLAKE_ACCOUNT>
SNOWFLAKE_ACCOUNT_URL=https://sfseeurope-demo_elizabethdendulk.snowflakecomputing.com
SNOWFLAKE_USER=AI_USER
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CUSTOM_DEMOS
SNOWFLAKE_SCHEMA=DEEPKI
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Programmatic access token for the Cortex Agent REST API (see README).
SNOWFLAKE_PAT=

# Tenant-scoped PATs for the multi-tenant isolation demo. Each belongs to a
# DIFFERENT Snowflake user whose DEFAULT role is that tenant's role — a Cortex
# Agent resolves privileges from the default role, not the session role, so
# isolation cannot be done by switching roles on one shared user. Leave empty to
# fall back to SNOWFLAKE_PAT (the demo then shows all clients).
SNOWFLAKE_PAT_RHENUS=
SNOWFLAKE_PAT_VANEAU=
